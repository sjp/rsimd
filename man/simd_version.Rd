\name{simd_version}
\alias{simd_version}
\title{Native Code Version}
\usage{
simd_version()
}
\description{
Reports the version of the compiled code in \pkg{rsimd}. This is not the
package version: it changes only when the native interface changes.
}
\value{
A character string of length one.
}
\examples{
simd_version()
}
